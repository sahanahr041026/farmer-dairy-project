# Environment: set to "production" to enforce strict startup checks (e.g. SECRET_KEY)
ENVIRONMENT=development

# Database
# PostgreSQL:  postgresql+psycopg://<user>:<password>@localhost:5432/dairysathi_db
# SQLite (local dev):
DATABASE_URL=sqlite:///./dairysathi.db

# Security - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Cattle Care AI Assistant (Optional - falls back cleanly to Curated Expert Advisory)
GEMINI_API_KEY=
OPENAI_API_KEY=

# SMS Gateway Integration (Optional - falls back cleanly to Simulated Development Mock Mode)
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=DAIRYSTH
